# Copy to backend/.env and replace placeholders with your own credentials.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=your-server-side-supabase-key
SUPABASE_STORAGE_BUCKET=meeting-audios
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
JWT_SECRET=replace-with-a-long-random-secret

# Optional model list and browser origins. Defaults match local development.
# GEMINI_MODELS=gemini-3.5-flash,gemini-2.5-flash-lite
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
